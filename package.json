{
  "name": "@ain3sh/context-mcp",
  "version": "1.0.0",
  "description": "MCP server for intelligent documentation management - fetch from Context7 and semantic search with Gemini File Search",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ain3sh/context-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "gemini",
    "context7",
    "documentation",
    "semantic-search",
    "file-search"
  ],
  "author": "ain3sh",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "context-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.18.1",
    "jsdom": "^30.0.0",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "gaxios": "7.3.0"
  }
}
